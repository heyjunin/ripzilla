FROM python:3.11-slim

# Instalar ffmpeg
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements e instalar dependências
COPY requirements.txt .
COPY worker/requirements.txt worker-requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r worker-requirements.txt

# Copiar biblioteca Ripzilla e dependências
COPY ripzilla/ /app/ripzilla/
COPY setup.py /app/

# Copiar código fonte do worker
COPY worker/src/worker.py /app/worker.py

# Criar diretório temporário para arquivos de áudio
RUN mkdir -p /tmp/ripzilla

# Configurar PYTHONPATH
ENV PYTHONPATH "${PYTHONPATH}:/app"

# Comando para executar o worker
CMD ["python", "worker.py"] 